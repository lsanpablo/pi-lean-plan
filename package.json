{
  "name": "pi-lean-plan",
  "version": "1.2.0",
  "description": "Deterministic read-only planning and checklist generation for pi-ralph-loop.",
  "type": "module",
  "license": "MIT",
  "author": "Luis San Pablo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsanpablo/pi-lean-plan.git"
  },
  "homepage": "https://github.com/lsanpablo/pi-lean-plan#readme",
  "bugs": {
    "url": "https://github.com/lsanpablo/pi-lean-plan/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "ralph-loop",
    "planning",
    "lean-plan"
  ],
  "files": [
    "extensions",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:plan-css": "tailwindcss -i ./assets/plan.css -o ./extensions/plan-tailwind.css --minify",
    "test": "node --test",
    "check": "npm run build:plan-css && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
